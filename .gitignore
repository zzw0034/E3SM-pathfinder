# Object files
*.lo
*.o

# Fortran module files
*.mod

# Static libraries
*.la
*.a

# Shared libraries
*.so
*.so.*

# Executables
*.exe

# Logs
*.log

# Ignore netCDF files.
*.nc

# Ignore python bytecode files
*.pyc
buildnmlc
buildlibc
buildlib_cmakec

#the site directory
site

# Ignore emacs backup files
*~

#Ignore Mac folder files
.DS_Store

# Ignore compiled output files
a.out

#Ignore vscode dir
.vscode

# Fortran LSP
.fortls.json

# Ignore mkdocs site-generated files in eamxx
components/eamxx/site/*
# Ignore auto-generated eamxx_params.md file
components/eamxx/docs/user/eamxx_params.md
# Ignore html generated for presentations in the source code
components/eamxx/docs/_presentations_html/

# Python packaging
*.egg-info
components/eamxx/src/python/build
components/eamxx/src/python/build_src
components/eamxx/src/python/dist

# Emulator Components
components/emulators/build
**/Testing/**
**/.cache/**

# ---- Pathfinder 工作副本的本地产物（zw5，2026-09-10）----
# Slurm 作业输出。jobs/ 下的 *.slurm 脚本本身是跟踪的，输出不跟踪。
jobs/*.out
jobs/*.err

# mksurfdata_map 在源码树里就地编译和运行的产物
components/elm/tools/mksurfdata_map/mksurfdata_map
components/elm/tools/mksurfdata_map/src/Depends
components/elm/tools/mksurfdata_map/clm.input_data_files
components/elm/tools/mksurfdata_map/*.out
components/elm/tools/mksurfdata_map/*.err

# 手工备份副本，例如 lnd_import_export.F90.bak.20260520、namelist.bak_c0723
*.bak
*.bak.*
*.bak_*

# Fortran 运行时按单元号写出的残留文件，例如 fort.99
fort.*
